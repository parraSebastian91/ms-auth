  "info": {
    "title": "ms-identity",
    "description": "Identidad y autenticación de SEIS App: Authorization Code + PKCE, ciclo de sesión, recuperación de contraseña, registro y perfil de usuario.\n\n**Flujo de login**: `POST /security/authorize` (credenciales + code_challenge) → código → `POST /security/token` (código + code_verifier) → cookies `auth.session` y `auth.refresh`. Las rutas de perfil usan el JWT de acceso como Bearer.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "auth.session"
      },
      "refresh": {
        "type": "apiKey",
        "in": "cookie",
        "name": "auth.refresh"
      }
    },
    "schemas": {
      "AuthorizeRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "sparra"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "code_challenge": {
            "type": "string",
            "description": "PKCE: BASE64URL(SHA256(code_verifier)), método S256."
          },
          "typeDevice": {
            "type": "string",
            "enum": [
              "WEB",
              "DESKTOP",
              "MOBILE",
              "POSTMAN"
            ]
          },
          "CorrelationId": {
            "type": "string",
            "description": "Id de correlación de este intento; debe repetirse como `cid` en /security/token."
          }
        },
        "required": [
          "CorrelationId",
          "code_challenge",
          "password",
          "typeDevice",
          "username"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "number",
            "example": 401
          },
          "message": {
            "type": "string",
            "example": "Usuario o contraseña incorrectos"
          }
        },
        "required": [
          "status",
          "message"
        ]
      },
      "TokenRequestDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Código de autorización devuelto por /security/authorize (un solo uso)."
          },
          "typeDevice": {
            "type": "string",
            "enum": [
              "WEB",
              "DESKTOP",
              "MOBILE",
              "POSTMAN"
            ],
            "description": "Debe coincidir con el usado en /security/authorize."
          },
          "codeVerifier": {
            "type": "string",
            "description": "PKCE: el code_verifier original cuyo hash se envió como code_challenge."
          },
          "cid": {
            "type": "string",
            "description": "CorrelationId enviado en /security/authorize."
          }
        },
        "required": [
          "code",
          "typeDevice",
          "codeVerifier",
          "cid"
        ]
      },
      "RefreshSessionRequestDto": {
        "type": "object",
        "properties": {
          "typeDevice": {
            "type": "string",
            "example": "WEB",
            "description": "Solo informativo (se usa en logs)."
          }
        }
      },
      "RequestPasswordResetDto": {
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "example": "ana@correo.cl"
          }
        },
        "required": [
          "correo"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "uuid": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "format": "password"
          },
          "confirmPassword": {
            "type": "string",
            "minLength": 8,
            "format": "password",
            "description": "Debe ser igual a newPassword."
          }
        },
        "required": [
          "token",
          "uuid",
          "newPassword",
          "confirmPassword"
        ]
      },
      "FormRegisterDto": {
        "type": "object",
        "properties": {
          "rol": {
            "type": "string",
            "enum": [
              "USUARIO_STANDARD",
              "CEDENTE",
              "CEDENTE_ADM",
              "EJECUTIVO",
              "EJECUTIVO_ADM"
            ],
            "description": "Rol inicial solicitado (el rol efectivo se asigna al verificar el correo)."
          },
          "email": {
            "type": "string",
            "example": "ana@correo.cl"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "example": "ana.perez"
          },
          "nombres": {
            "type": "string",
            "minLength": 2
          },
          "apellidoPaterno": {
            "type": "string",
            "minLength": 2
          },
          "apellidoMaterno": {
            "type": "string",
            "minLength": 2
          },
          "telefono": {
            "type": "string",
            "minLength": 7,
            "maxLength": 20,
            "example": "+56912345678"
          },
          "tipoDocumento": {
            "type": "string",
            "enum": [
              "DNI",
              "RUT",
              "PASAPORTE"
            ]
          },
          "numeroDocumento": {
            "type": "string",
            "example": "12345678-9"
          },
          "pais": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "example": "CL",
            "description": "Código ISO de 2 letras."
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date",
            "example": "1990-05-31"
          },
          "direccion": {
            "type": "string",
            "minLength": 5
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "format": "password"
          }
        },
        "required": [
          "rol",
          "email",
          "username",
          "nombres",
          "apellidoPaterno",
          "apellidoMaterno",
          "telefono",
          "tipoDocumento",
          "numeroDocumento",
          "pais",
          "fechaNacimiento",
          "direccion",
          "password"
        ]
      },
      "VerificarEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@correo.cl"
          },
          "otp": {
            "type": "string",
            "minLength": 6,
            "maxLength": 6,
            "example": "123456"
          }
        },
        "required": [
          "email",
          "otp"
        ]
      },
      "ResendOtpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@correo.cl"
          }
        },
        "required": [
          "email"
        ]
      },
      "UserProfileDTO": {
        "type": "object",
        "properties": {
          "usuario_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "ingreso": {
            "format": "date-time",
            "type": "string",
            "description": "Fecha de alta."
          },
          "activo": {
            "type": "boolean"
          },
          "nombres": {
            "type": "string"
          },
          "apellido_paterno": {
            "type": "string"
          },
          "apellido_materno": {
            "type": "string"
          },
          "direccion": {
            "type": "string",
            "nullable": true
          },
          "celular": {
            "type": "string",
            "nullable": true
          },
          "correo": {
            "type": "string"
          },
          "fecha_nacimiento": {
            "format": "date",
            "type": "string",
            "nullable": true
          },
          "redes_sociales": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "tipo_documento": {
            "type": "string",
            "nullable": true,
            "example": "RUT"
          },
          "numero_documento": {
            "type": "string",
            "nullable": true
          },
          "tipo_contacto": {
            "type": "string",
            "nullable": true
          },
          "roles": {
            "example": [
              "CLIENTE_CEDENTE"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "usuario_uuid",
          "username",
          "ingreso",
          "activo",
          "nombres",
          "apellido_paterno",
          "apellido_materno",
          "direccion",
          "celular",
          "correo",
          "fecha_nacimiento",
          "redes_sociales",
          "tipo_documento",
          "numero_documento",
          "tipo_contacto",
          "roles"
        ]
      },
      "NombreDto": {
        "type": "object",
        "properties": {
          "nombres": {
            "type": "string"
          },
          "apellidoPaterno": {
            "type": "string"
          },
          "apellidoMaterno": {
            "type": "string"
          }
        }
      },
      "DatosContactoDto": {
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "example": "ana@correo.cl"
          },
          "telefono": {
            "type": "string"
          },
          "ubicacion": {
            "type": "string"
          }
        }
      },
      "UpdateUserProfileRequestDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "$ref": "#/components/schemas/NombreDto"
          },
          "datosContacto": {
            "$ref": "#/components/schemas/DatosContactoDto"
          }
        }
      }
    }
  }
}
