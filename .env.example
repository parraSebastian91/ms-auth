# =============================================================================
# ms-identity — Variables de entorno
# Copia este archivo como .env (desarrollo local) o .env.container (Docker)
# y rellena los valores marcados con <...>
# NUNCA subas archivos .env con valores reales al repositorio.
# =============================================================================

# ── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=2000

# TTLs en segundos
TTL_AUTH_CODE=60          # Tiempo de vida del código de autorización PKCE
TTL_SESSION=3600          # Tiempo de vida del access token en Redis (1 h)
TTL_REFRESH_SESSION=86400 # Tiempo de vida de la sesión de refresh (24 h)

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
# Opciones para DATABASE_HOST:
#   localhost            → PostgreSQL en el host
#   seis_erp_postgres   → PostgreSQL en Docker (mismo compose)
DATABASE_HOST=seis_erp_postgres
DATABASE_PORT=5432
DATABASE_USER=<db_user>
DATABASE_PASSWORD=<db_password>
DATABASE_NAME=<db_name>
DATABASE_SCHEMA_IDENTITY=identity

# ── Redis ─────────────────────────────────────────────────────────────────────
# Opciones para REDIS_HOST:
#   localhost         → Redis en el host
#   seis_erp_redis   → Redis en Docker (mismo compose)
REDIS_HOST=seis_erp_redis
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera valores seguros con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_REFRESH_SECRET=<random_hex_32_bytes>
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_SECRET=<random_hex_32_bytes>
JWT_ACCESS_EXPIRES_IN=5m
JWT_ACCESS_ADMIN_EXPIRES_IN=15m

# ── Sesión HTTP ───────────────────────────────────────────────────────────────
SESSION_NAME=auth.session
SECRET_SESSION=<random_string_min_32_chars>

# ── Servicios externos ────────────────────────────────────────────────────────
API_PREFIX=api/v1
MS_CORE_URL=http://ms_core:3001
FRONTEND_ORIGIN=http://localhost:4201

# ── HashiCorp Vault ───────────────────────────────────────────────────────────
# El token lo genera Vault al inicializar: vault token create -policy=ms-identity
VAULT_ADDR=http://vault_server:8200
VAULT_TOKEN=<vault_token>

# Documentación OpenAPI en /docs (por defecto activa fuera de producción)
# SWAGGER_ENABLED=true

# Límite de intentos (login, reset de contraseña, registro y OTP). Por defecto activo.
# RATE_LIMIT_ENABLED=false
# Dónde viven los contadores: Redis (por defecto, el mismo REDIS_* del servicio; compartido entre réplicas y
# sobrevive a reinicios) o memoria. Si Redis falla, cada instancia cae a su memoria (sin 500) y lo avisa en el log.
# RATE_LIMIT_STORAGE=memory
# REDIS_DB=0
# Saltos de proxy en los que se confía para la IP del cliente (X-Forwarded-For). Por defecto 1: los servicios
# siempre están detrás de APISIX. Subir solo si se agrega otro proxy delante; NO poner "true".
# TRUST_PROXY_HOPS=1
