# Variables de entorno — ms-auth
# Copiar a .env.dev / .env.container / .env.prod según el entorno y
# completar con valores reales (nunca commitear esos archivos — ver
# .gitignore). Ninguno de los valores de abajo es un secreto real.
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
# Opciones:
# - localhost (si PostgreSQL está en el host)
# - nombre_del_contenedor_postgres (si está en Docker)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=CHANGE_ME
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=CHANGE_ME
DATABASE_SCHEMA=core

# Redis
# Opciones:
# - localhost (si Redis está en el host)
# - nombre_del_contenedor_redis (si está en Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=3600

# JWT — generar valores propios por entorno, nunca reusar el mismo secreto
# para access y refresh
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=5m
JWT_ACCESS_ADMIN_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
API_PREFIX=api/v1

# Servicios externos
CORE_SERVICE_BASE_URL=http://localhost:3001
STORAGE_SERVICE_URL=http://localhost:3100

# Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=CHANGE_ME

# Sesión / CORS
FRONTEND_ORIGIN=http://localhost:4201
SESSION_NAME=sid
SECRET_SESSION=CHANGE_ME

# Messaging (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASS=CHANGE_ME
RABBITMQ_QUEUE=notify_queue
RABBITMQ_EXCHANGE=storage_notifications_exchange
RABBITMQ_ROUTING_KEY=dte.process.notification
RABBITMQ_ROUTING_KEY_FAIL=dte.process.notification.fail
